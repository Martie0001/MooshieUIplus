diff --git a/src/lib/addons/lora-browser/LoraExternalSearch.svelte b/src/lib/addons/lora-browser/LoraExternalSearch.svelte
new file mode 100644
index 0000000..5b3a92f
--- /dev/null
+++ b/src/lib/addons/lora-browser/LoraExternalSearch.svelte
@@ -0,0 +1,101 @@
+<script lang="ts">
+  import {
+    searchCivitaiModels,
+    downloadModel,
+    type CivitaiModel,
+  } from "../../utils/api.js";
+  // This component is copied to src/lib/addons/lora-browser by install.mjs.
+  let query = $state("");
+  let searching = $state(false);
+  let error = $state("");
+  let results = $state<CivitaiModel[]>([]);
+  let page = $state(1);
+  let hasMore = $state(false);
+  let busyId = $state<number | null>(null);
+  let status = $state("");
+  let currentSearch = $state("");
+  let sequence = 0;
+
+  async function search(nextPage = 1) {
+    const token = ++sequence;
+    searching = true;
+    error = "";
+    status = "";
+    try {
+      const response = await searchCivitaiModels({
+        query: query.trim() || undefined, type: "LORA", page: nextPage, limit: 20,
+      });
+      if (token !== sequence) return;
+      currentSearch = query.trim();
+      results = nextPage === 1 ? response.items : [
+        ...results,
+        ...response.items.filter((item) => !results.some((prev) => prev.id === item.id)),
+      ];
+      page = nextPage;
+      hasMore = response.items.length > 0
+        && (response.metadata.nextCursor ? false : nextPage < (response.metadata.totalPages ?? 1));
+    } catch (e) {
+      if (token === sequence) error = e instanceof Error ? e.message : String(e);
+    } finally {
+      if (token === sequence) searching = false;
+    }
+  }
+
+  async function install(item: CivitaiModel) {
+    const version = item.modelVersions[0];
+    const file = version?.files.find((f) => f.name.toLowerCase().endsWith(".safetensors"));
+    if (!file?.downloadUrl) {
+      error = "這個版本沒有可下載的 safetensors 檔案。";
+      return;
+    }
+    if (!confirm(`下載 LoRA「${item.name}」至本地模型目錄？\n檔案：${file.name}`)) return;
+    busyId = item.id;
+    error = "";
+    status = "";
+    try {
+      await downloadModel(file.downloadUrl, "loras", file.name);
+      status = `已送出下載：${file.name}。完成後請在「本地LORA」按重新整理。`;
+    } catch (e) {
+      error = e instanceof Error ? e.message : String(e);
+    } finally {
+      busyId = null;
+    }
+  }
+</script>
+
+<div class="space-y-2 text-[11px]">
+  <p class="text-neutral-400">CivitAI 外部 LoRA 搜尋</p>
+  <form class="flex items-center gap-1" onsubmit={(event) => { event.preventDefault(); void search(); }}>
+    <input class="min-w-0 flex-1 rounded border border-neutral-700 bg-neutral-800 px-2 py-1.5 text-neutral-100"
+      type="search" bind:value={query} placeholder="搜尋 CivitAI LoRA 名稱" aria-label="搜尋外部 LoRA" />
+    <button type="submit" disabled={searching} class="rounded border border-neutral-600 px-3 py-1.5 hover:border-indigo-500 disabled:opacity-50">
+      {searching ? "搜尋中…" : "搜尋"}
+    </button>
+  </form>
+  {#if error}<p class="text-amber-300 break-all" role="alert">{error}</p>{/if}
+  {#if status}<p class="text-emerald-300">{status}</p>{/if}
+  {#if results.length > 0}
+    <div class="max-h-52 overflow-y-auto space-y-1 rounded border border-neutral-800 p-1">
+      {#each results as item (item.id)}
+        <div class="flex items-center gap-2 border-b border-neutral-800 px-1 py-1">
+          {#if item.modelVersions[0]?.images?.[0]?.url}
+            <img src={item.modelVersions[0].images[0].url} alt="" loading="lazy" class="h-10 w-10 shrink-0 rounded object-cover" />
+          {:else}
+            <div class="h-10 w-10 shrink-0 rounded bg-neutral-800"></div>
+          {/if}
+          <div class="min-w-0 flex-1">
+            <p class="truncate text-neutral-200" title={item.name}>{item.name}</p>
+            <p class="truncate text-neutral-500">{item.modelVersions[0]?.baseModel ?? "底模未提供"} · {item.creator?.username ?? "作者未提供"}</p>
+          </div>
+          <a class="shrink-0 text-indigo-300 hover:underline" href="https://civitai.com/models/{item.id}" target="_blank" rel="noopener noreferrer">詳情</a>
+          <button type="button" disabled={busyId !== null}
+            class="shrink-0 rounded border border-neutral-700 px-2 py-1 hover:border-indigo-500 disabled:opacity-40"
+            onclick={() => void install(item)}>{busyId === item.id ? "處理中…" : "下載"}</button>
+        </div>
+      {/each}
+    </div>
+    {#if hasMore}<button type="button" disabled={searching} onclick={() => void search(page + 1)} class="text-indigo-300 hover:underline">載入更多</button>{/if}
+  {:else if currentSearch && !searching && !error}
+    <p class="text-neutral-500">沒有搜尋結果。</p>
+  {/if}
+</div>
diff --git a/src/lib/addons/lora-browser/LoraFilterBar.svelte b/src/lib/addons/lora-browser/LoraFilterBar.svelte
new file mode 100644
index 0000000..77d36c4
--- /dev/null
+++ b/src/lib/addons/lora-browser/LoraFilterBar.svelte
@@ -0,0 +1,181 @@
+<script lang="ts">
+  import { onMount } from "svelte";
+  import type { LoraFilter, LoraGame } from "./loraCategories.js";
+
+  interface Props {
+    activeTab: LoraFilter | "";
+    gameFilter: LoraGame | "";
+    games: LoraGame[];
+  }
+
+  let { activeTab = $bindable(), gameFilter = $bindable(), games = [] }: Props = $props();
+
+  const STORAGE_KEY = "mooshieui.plus.localLoraFilters.split.v1";
+  const MIN_HEIGHT = 36;
+  const MAX_HEIGHT = 260;
+  const DEFAULT_HEIGHT = 43;
+  const DEFAULT_LEFT_PERCENT = 64;
+  const tabs: { value: LoraFilter; label: string }[] = [
+    { value: "all", label: "全部" },
+    { value: "character", label: "角色" },
+    { value: "style", label: "風格" },
+    { value: "clothing", label: "服裝" },
+    { value: "effect", label: "效果" },
+    { value: "other", label: "其他" },
+  ];
+
+  let panel = $state<HTMLDivElement>();
+  let leftPercent = $state(DEFAULT_LEFT_PERCENT);
+  let panelHeight = $state(DEFAULT_HEIGHT);
+  let dragging = $state<"horizontal" | "vertical" | null>(null);
+
+  onMount(() => {
+    try {
+      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "{}");
+      if (typeof saved.leftPercent === "number" && Number.isFinite(saved.leftPercent)) {
+        leftPercent = Math.max(10, Math.min(85, saved.leftPercent));
+      }
+      if (typeof saved.panelHeight === "number" && Number.isFinite(saved.panelHeight)) {
+        panelHeight = Math.max(MIN_HEIGHT, Math.min(MAX_HEIGHT, saved.panelHeight));
+      }
+    } catch {
+      // Invalid optional layout preferences do not block the selector.
+    }
+  });
+
+  function storeLayout() {
+    try {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify({ leftPercent, panelHeight }));
+    } catch {
+      // Dragging remains available even if preferences cannot be persisted.
+    }
+  }
+
+  function splitLimits(width: number) {
+    const leftMin = Math.min(250, width * 0.48);
+    const rightMin = Math.min(195, width * 0.34);
+    return {
+      min: (leftMin / Math.max(width, 1)) * 100,
+      max: ((width - rightMin - 8) / Math.max(width, 1)) * 100,
+    };
+  }
+
+  function moveDivider(event: PointerEvent, direction: "horizontal" | "vertical") {
+    if (!panel || dragging !== direction) return;
+    const box = panel.getBoundingClientRect();
+    if (direction === "vertical") {
+      const limits = splitLimits(box.width);
+      leftPercent = Math.max(limits.min, Math.min(limits.max, ((event.clientX - box.left) / box.width) * 100));
+    } else {
+      panelHeight = Math.max(MIN_HEIGHT, Math.min(MAX_HEIGHT, event.clientY - box.top));
+    }
+  }
+
+  function startDivider(event: PointerEvent, direction: "horizontal" | "vertical") {
+    if (event.button !== 0) return;
+    dragging = direction;
+    (event.currentTarget as HTMLElement).setPointerCapture(event.pointerId);
+    event.preventDefault();
+  }
+
+  function endDivider(event: PointerEvent) {
+    const element = event.currentTarget as HTMLElement;
+    if (element.hasPointerCapture(event.pointerId)) element.releasePointerCapture(event.pointerId);
+    dragging = null;
+    storeLayout();
+  }
+
+  function moveByKeyboard(event: KeyboardEvent, direction: "horizontal" | "vertical") {
+    if (event.key === "Home") {
+      if (direction === "vertical") leftPercent = splitLimits(panel?.clientWidth ?? 900).min;
+      else panelHeight = MIN_HEIGHT;
+    } else if (event.key === "End") {
+      if (direction === "vertical") leftPercent = splitLimits(panel?.clientWidth ?? 900).max;
+      else panelHeight = MAX_HEIGHT;
+    } else if (direction === "vertical" && (event.key === "ArrowLeft" || event.key === "ArrowRight")) {
+      leftPercent += event.key === "ArrowLeft" ? -2 : 2;
+      const limits = splitLimits(panel?.clientWidth ?? 900);
+      leftPercent = Math.max(limits.min, Math.min(limits.max, leftPercent));
+    } else if (direction === "horizontal" && (event.key === "ArrowUp" || event.key === "ArrowDown")) {
+      panelHeight = Math.max(MIN_HEIGHT, Math.min(MAX_HEIGHT, panelHeight + (event.key === "ArrowUp" ? -10 : 10)));
+    } else {
+      return;
+    }
+    event.preventDefault();
+    storeLayout();
+  }
+
+  function resetLayout() {
+    leftPercent = DEFAULT_LEFT_PERCENT;
+    panelHeight = DEFAULT_HEIGHT;
+    storeLayout();
+  }
+
+  function chooseType(value: LoraFilter) {
+    activeTab = value;
+    gameFilter = "all";
+  }
+</script>
+
+<div class="shrink-0 px-2 pt-1.5" aria-label="LoRA 分類與資料夾篩選">
+  <div bind:this={panel} class="min-w-0">
+    <div class="grid min-w-0 overflow-hidden"
+      style:height={panelHeight + "px"}
+      style:grid-template-columns={`minmax(0, ${leftPercent}%) 8px minmax(0, 1fr)`}>
+      <div class="min-w-0 overflow-x-auto overflow-y-auto overscroll-contain pr-1" aria-label="LoRA 類型">
+        <div class="flex w-max min-w-full flex-nowrap items-center gap-1 py-0.5" role="group" aria-label="LoRA 類型">
+          {#each tabs as tab (tab.value)}
+            <button type="button" onclick={() => chooseType(tab.value)}
+              aria-pressed={activeTab === tab.value}
+              class="shrink-0 rounded-md px-2 py-1 text-[11px] border transition-colors {activeTab === tab.value ? 'border-indigo-500/70 bg-indigo-500/20 text-indigo-200' : 'border-neutral-700 text-neutral-400 hover:text-neutral-200 hover:border-neutral-500'}">
+              {tab.label}
+            </button>
+          {/each}
+        </div>
+      </div>
+
+      <div role="separator" tabindex="0" aria-label="調整分類與資料夾寬度" aria-orientation="vertical"
+        aria-valuemin={Math.round(splitLimits(panel?.clientWidth || 900).min)}
+        aria-valuemax={Math.round(splitLimits(panel?.clientWidth || 900).max)}
+        aria-valuenow={Math.round(leftPercent)}
+        title="左右拖曳調整寬度，雙擊恢復預設"
+        class="group z-10 flex h-full w-2 cursor-col-resize touch-none items-stretch justify-center rounded outline-none focus-visible:bg-neutral-500/40"
+        onpointerdown={(event) => startDivider(event, "vertical")}
+        onpointermove={(event) => moveDivider(event, "vertical")}
